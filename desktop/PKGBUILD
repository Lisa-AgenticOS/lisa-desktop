# Maintainer: Lisa OS project <https://github.com/Lisa-AgenticOS/lisa-desktop>
#
# Lisa Desktop — the GNOME Shell fork (ADR-0038 step 2).
#
# THIS FILE IS THE PIN. pkgver below is the upstream GNOME Shell release
# this package is built from, and the first entry of sha256sums is the
# hash of that release's tarball. No other file in this repository names
# an upstream version; tools/rebase.sh reads and rewrites these two lines
# and nothing else.
#
# Derived from Arch's gnome-shell PKGBUILD (1:50.4-1) — same dependency
# set, same meson flags, same compiler flags, same install prefix — so
# that what we build is the same code the reference device already runs.
# One deliberate difference: the source is the release tarball verified
# against GNOME's published checksum rather than a git tag.
#
# THIS PACKAGE REPLACES gnome-shell; it does not sit beside it. It
# installs to /usr, provides=(gnome-shell) and conflicts=(gnome-shell),
# and pacman removes the stock package when this one is installed.
#
# It used to install to a private /usr/lib/lisa-desktop prefix so the
# two could co-exist. That is gone, and the reasoning is worth keeping
# because it is the whole argument for this shape:
#
#   * a private prefix moves the D-Bus .service files of the shell's
#     activatable helpers (Extensions, Notifications, Screencast,
#     ScreenSaver, CalendarServer) to a directory the session bus does
#     not scan — which is why the package used to carry a transitional
#     depends=(gnome-shell) to borrow stock's copies;
#   * it needs GSETTINGS_SCHEMA_DIR in the shell's unit, and that
#     directory takes precedence over /usr/share/glib-2.0/schemas for
#     every schema it contains. org.gnome.shell is one of them, so
#     lisa-shell's 10_lisa-shell.gschema.override — the file that
#     enables the three Lisa extensions — was silently bypassed.
#     Measured, not theorised: with GSETTINGS_SCHEMA_DIR set, `gsettings
#     get org.gnome.shell enabled-extensions` returned [] while the
#     stock lookup returned the override's value;
#   * /usr/share/gnome-shell/extensions, /usr/share/applications and
#     /etc/dconf are XDG_DATA_DIRS/backend-level and were fine either
#     way — but "fine for three of the five" is exactly the class of bug
#     this repository keeps producing (#241).
#
# Nothing is co-installed, so none of that cost buys anything. The
# fallback if this shell does not start is the previous A/B root slot
# (ADR-0001), and behind that the dd-able USB image — not a second
# desktop on the same disk.
#
# The Lisa delta is no longer empty, and it is worth being precise about
# what ended that. patches/ holds two patches:
#
#   0001  NOT ours — Arch's one-line libical-4 build fix, without which
#         upstream 50.4 does not compile against the libical the device
#         ships. It should be dropped, not edited, when upstream fixes
#         it.
#   0002  the first deliberate divergence (lisa-os#266): Lisa Desktop
#         grants org.gnome.Shell.Screenshot to Lisa's own root-owned
#         system binaries, which stock GNOME 50 refuses to everything
#         but the media-keys daemon and the portal. Two upstream files
#         touched, one added.
#
# Step 2's acceptance criterion — byte-identical to stock — was met and
# is recorded; CI's js-delta step now prints the delta and asserts it is
# exactly those two interface resources and no others.

pkgname=lisa-desktop-shell
pkgver=50.4
pkgrel=1
pkgdesc="Lisa Desktop: the GNOME Shell fork, installed in place of gnome-shell"
# x86_64 only, and only because that is the only architecture this has
# been built on. ADR-0021's aarch64 lane is unproven here; widen this
# line when a build exists, not before.
arch=(x86_64)
url="https://github.com/Lisa-AgenticOS/lisa-desktop"
# GPL-3.0-or-later, NOT the repository's GPL-2.0-only (ADR-0005): the
# vendored source is GNOME Shell, which is GPL-3.0-or-later, and a
# derived work cannot be relicensed downwards. Upstream's COPYING is
# installed next to ours for the same reason.
license=(GPL-3.0-or-later)
depends=(
  # Arch's gnome-shell 1:50.4-1 runtime dependency set, verbatim.
  accountsservice
  at-spi2-core
  bash
  cairo
  dconf
  gcr-4
  gdk-pixbuf2
  gjs
  glib2
  glibc
  gnome-autoar
  gnome-desktop-4
  gnome-session
  gnome-settings-daemon
  graphene
  gsettings-desktop-schemas
  gtk4
  hicolor-icon-theme
  ibus
  json-glib
  libadwaita
  libcanberra-pulse
  libgcc
  libgdm
  libglvnd
  libgweather-4
  libibus
  libical
  libnm
  libnma-gtk4
  libpipewire
  libpulse
  libsecret
  libsoup3
  libx11
  libxext
  libxfixes
  libmutter-18.so
  mutter
  pango
  polkit
  systemd-libs
  unzip
  upower
  webkitgtk-6.0
)
# We ARE gnome-shell: same files, same prefix, same org.gnome.Shell.*
# bus names, built from the same release. The version carries Arch's
# epoch so a versioned dependency (`gnome-shell>=1:50`) resolves against
# this the way it would against the package it replaces.
provides=("gnome-shell=1:${pkgver}-${pkgrel}")
conflicts=(gnome-shell)
# NOT replaces=(). `replaces` makes any `pacman -Syu` that can see the
# [lisa] repo remove stock gnome-shell without being asked, which is the
# wrong default for Track L — [lisa] is layered on somebody's own Arch or
# Omarchy install (ADR-0003), and taking their desktop away as a side
# effect of an upgrade is not ours to do. The image installs this package
# by name, so it needs no help. `conflicts` still makes the swap a single
# explicit `pacman -S lisa-desktop-shell`.
makedepends=(
  asciidoc
  bash-completion
  evolution-data-server
  git
  glib2-devel
  gnome-keybindings
  gobject-introspection
  meson
  python-docutils
  sassc
)
optdepends=(
  'gnome-control-center: System settings'
  'gnome-bluetooth-3.0: Bluetooth support'
  'gst-plugin-pipewire: Screen recording'
  'gst-plugins-good: Screen recording'
  'power-profiles-daemon: Power profile switching'
  'switcheroo-control: Multi-GPU support'
)
# !debug: consistent with this repo's other packages — a stray
# -debug split package is index noise nobody consumes.
options=(!debug)

# Two sources, and the split matters:
#   [0] pristine upstream, fetched from GNOME's release server and
#       verified against the sha256 published beside it. Arch builds
#       from a git tag instead because GNOME Shell's tags carry SSH
#       signatures makepkg cannot verify; a hash of an immutable
#       artefact is a stronger pin than an unverifiable tag.
#   [1] a git archive of THIS repository at HEAD, produced by
#       build-package.sh. SKIP because it is generated from committed
#       history at build time — hashing it here would be hashing a file
#       against itself. It carries patches/, session/ and the LICENSE.
source=(
  "https://download.gnome.org/sources/gnome-shell/${pkgver%%.*}/gnome-shell-$pkgver.tar.xz"
  "lisa-desktop-tree.tar.gz"
)
sha256sums=(
  'c531939539db316a41aef23670370abd1330d3254f84bcb0f9f4dae5d6e362cf'
  'SKIP'
)

prepare() {
  # --- The vendoring seam -------------------------------------------
  # Upstream becomes commit 1 of a throwaway git repository inside
  # $srcdir; our delta becomes commits 2..n, applied with `git am
  # --3way`. tools/apply-series.sh does it, and is the only place that
  # does it — the rebase tool and CI call the same script, so the build
  # and the rebase cannot disagree about what the fork is.
  #
  # Why this and not the anchored sed/awk of gnome-control-center-lisa:
  # a patch hunk carries its own context and the blob hash of the file
  # it was cut from, so the applier itself refuses a hunk whose
  # surroundings moved. There is no third outcome. `sed -i s/x/y/` that
  # matches nothing exits 0 and silently ships the unpatched file, which
  # is why that PKGBUILD needs nine hand-written grep guards — one per
  # edit, each added by somebody remembering to. Here the guard is the
  # applier: it exists for every hunk, for free, forever.
  bash "$srcdir/lisa/desktop/tools/apply-series.sh" \
    "$srcdir/gnome-shell-$pkgver" \
    "$srcdir/lisa/desktop/patches" \
    "gnome-shell $pkgver (pristine upstream release tarball)"
}

build() {
  local meson_options=(
    # The stock prefix, which is also the point: every installed path in
    # this project derives from it (bindir, libdir, libexecdir, datadir,
    # pkgdatadir, pkglibdir, the systemd user unit dir, the D-Bus service
    # dir and the gnome-control-center keybindings dir), and the binary
    # compiles its own datadir and typelibdir into itself. Building at
    # /usr means every one of those resolves to the path the rest of the
    # system already reads — no relocation, no search-path work, and the
    # js-delta comparison below needs no allowance for it either.
    --prefix=/usr
    --sysconfdir=/etc
    --localstatedir=/var
    # Arch's flags. gtk_doc is the one deviation: Arch builds the API
    # reference into a gnome-shell-docs package we do not ship, and
    # building it would pull the gi-docgen wrap over the network.
    # Documentation is not behaviour.
    -D gtk_doc=false
    -D tests=false
  )

  # Byte-for-byte the same code generation as Arch's gnome-shell.
  CFLAGS="${CFLAGS/-O2/-O3} -fno-semantic-interposition"
  LDFLAGS+=" -Wl,-Bsymbolic-functions"

  # The release tarball already contains gvc, libshew, jasmine-gjs and
  # the two extensions subprojects as real directories, so nothing is
  # fetched at build time; --wrap-mode=nodownload (from arch-meson)
  # turns a missing one into an error rather than a silent download.
  arch-meson "gnome-shell-$pkgver" build "${meson_options[@]}"

  # arch-meson passes --prefix /usr of its own and ours repeats it, so
  # this can no longer come out wrong by accident — but it is the pin
  # that every path assertion downstream rests on, and reading it from
  # meson's own introspection data costs nothing. (Not the
  # human-readable option table: its column layout is not an interface.)
  python -c 'import json,sys; d=json.load(open("build/meson-info/intro-buildoptions.json")); v=[o["value"] for o in d if o["name"]=="prefix"][0]; sys.exit(0 if v==sys.argv[1] else print(f"meson prefix is {v!r}, expected {sys.argv[1]!r}") or 1)' /usr

  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  # No glib-compile-schemas here, deliberately. meson skips
  # gnome.post_install() under DESTDIR, and stock gnome-shell does not
  # ship a gschemas.compiled either — /usr/share/glib-2.0/schemas is
  # compiled once, after every package is installed, by glib2's pacman
  # hook (and, in the image, by os/mkosi/mkosi.postinst.chroot, because
  # mkosi points pacman's --hookdir at the image's own empty hook dir).
  # That single compile is what folds lisa-shell's
  # 10_lisa-shell.gschema.override into org.gnome.shell's defaults, and
  # it is the reason this package must own that schema at the shared
  # path rather than at a private one.

  # --- Guard 1: we changed nothing upstream installed ----------------
  # Snapshot the payload as meson left it, so the check below is a set
  # difference against reality rather than a list of paths somebody
  # remembered. Anything upstream adds in a future release simply joins
  # the snapshot; anything WE add has to be named.
  local upstream
  upstream=$(cd "$pkgdir" && find . -mindepth 1 \( -type f -o -type l \) -printf '%P\n' | LC_ALL=C sort)

  cd "$srcdir/lisa"

  # --- The session ---------------------------------------------------
  # Five files, all of them ours, none of them a copy of a gnome-shell
  # file with a word changed. Together they are the whole difference
  # between "a shell binary exists" and "GDM offers Lisa Desktop".
  install -Dm644 desktop/session/lisa-desktop.desktop \
    "$pkgdir/usr/share/wayland-sessions/lisa-desktop.desktop"
  install -Dm644 desktop/session/lisa.session \
    "$pkgdir/usr/share/gnome-session/sessions/lisa.session"
  install -Dm644 desktop/session/lisa-desktop@.service \
    "$pkgdir/usr/lib/systemd/user/lisa-desktop@.service"
  install -Dm644 desktop/session/lisa-desktop-disable-extensions.service \
    "$pkgdir/usr/lib/systemd/user/lisa-desktop-disable-extensions.service"
  install -Dm644 desktop/session/lisa-session.conf \
    "$pkgdir/usr/lib/systemd/user/gnome-session@lisa.target.d/lisa-session.conf"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/gnome-shell-$pkgver/COPYING" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING.gnome-shell"

  # The set of paths this package adds to upstream's payload, computed
  # rather than declared. It must equal the list below EXACTLY — an
  # extra file is as much a failure as a missing one, because at this
  # prefix every path we add is a path stock gnome-shell did not have,
  # and "byte-identical to stock plus a named session" is the entire
  # claim of ADR-0038 step 2 expressed as packaging.
  local added expected
  added=$(cd "$pkgdir" && find . -mindepth 1 \( -type f -o -type l \) -printf '%P\n' \
            | LC_ALL=C sort | LC_ALL=C comm -13 <(printf '%s\n' "$upstream") -)
  expected=$(LC_ALL=C sort <<-EOF
	usr/lib/systemd/user/gnome-session@lisa.target.d/lisa-session.conf
	usr/lib/systemd/user/lisa-desktop-disable-extensions.service
	usr/lib/systemd/user/lisa-desktop@.service
	usr/share/gnome-session/sessions/lisa.session
	usr/share/licenses/$pkgname/COPYING.gnome-shell
	usr/share/licenses/$pkgname/LICENSE
	usr/share/wayland-sessions/lisa-desktop.desktop
	EOF
  )
  if [ "$added" != "$expected" ]; then
    echo "what this package adds to upstream's payload is not what it says it adds:" >&2
    diff <(printf '%s\n' "$expected") <(printf '%s\n' "$added") >&2 || true
    return 1
  fi

  # --- Guard 2: everything we add is Lisa-named ----------------------
  # Every path above lands in a namespace shared with packages that stay
  # (gnome-session owns /usr/share/gnome-session/sessions, systemd owns
  # /usr/lib/systemd/user). A Lisa-named component — the file, or a
  # directory that is ours — is what keeps `pacman -Qo` unambiguous and
  # what keeps a future upstream file from colliding with one of these.
  # Kept as a property of every added path, not a list.
  local unnamed
  unnamed=$(printf '%s\n' "$added" | grep -v lisa || true)
  if [ -n "$unnamed" ]; then
    echo "these added paths are in a shared namespace but nothing about them says Lisa:" >&2
    echo "$unnamed" >&2
    return 1
  fi
}

