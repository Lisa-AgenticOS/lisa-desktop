 import {ScreencastErrors, ScreencastError} from '../misc/dbusErrors.js';
 import {loadInterfaceXML} from '../misc/fileUtils.js';
+import {lisaSystemCaller} from '../misc/lisaSystemCaller.js';
 import {DBusSenderChecker} from '../misc/util.js';
 
 const ScreenshotIface = loadInterfaceXML('org.gnome.Shell.Screenshot');
@@ -2502,6 +2503,7 @@ export class ScreenshotService {
             lockedDown = this._lockdownSettings.get_boolean('disable-save-to-disk');
 
         const sender = invocation.get_sender();
+        let lisaCaller = null;
         if (this._screenShooter.has(sender)) {
             invocation.return_error_literal(
                 Gio.IOErrorEnum, Gio.IOErrorEnum.BUSY,
@@ -2516,12 +2518,36 @@ export class ScreenshotService {
             try {
                 await this._senderChecker.checkInvocation(invocation);
             } catch (e) {
-                invocation.return_gerror(e);
-                return null;
+                // Lisa Desktop (lisa-os#266): upstream's allowlist is two
+                // well-known bus names — the media-keys daemon, i.e. the
+                // human pressing Print, and the portal, i.e. the
+                // interactive-consent path. Neither is reachable by the
+                // OS's own tooling, so on stock GNOME 50 Lisa cannot
+                // photograph its own screen: not for the owner, not for
+                // CI on real hardware, not for a bug report.
+                //
+                // A bus name would be the wrong way to fix that — see
+                // misc/lisaSystemCaller.js. This asks the transport who
+                // the caller is instead, and grants the capability to
+                // Lisa's own root-owned system binaries and to nothing
+                // else. Everything upstream refuses, it still refuses.
+                lisaCaller = await lisaSystemCaller(invocation);
+                if (!lisaCaller) {
+                    invocation.return_gerror(e);
+                    return null;
+                }
+                console.log('Lisa Desktop: screen capture by ' +
+                    `${lisaCaller.exe} (pid ${lisaCaller.pid})`);
             }
         }
 
         const shooter = new Shell.Screenshot();
+        // A capture nobody can see is a camera with the light disabled.
+        // The flash is an argument on the D-Bus method, so a caller can
+        // ask for silence; a Lisa-authorised caller does not get to. The
+        // shell is the only place this can be enforced, because it is
+        // the only participant the caller cannot rewrite.
+        shooter._lisaForceFlash = lisaCaller !== null;
         shooter._watchNameId = Gio.bus_watch_name(Gio.BusType.SESSION,
             sender, 0, null, this._onNameVanished.bind(this));
 
@@ -2669,7 +2695,7 @@ export class ScreenshotService {
 
         try {
             await Promise.all([
-                flash ? this._flashAsync(screenshot) : null,
+                flash || screenshot._lisaForceFlash ? this._flashAsync(screenshot) : null,
                 screenshot.screenshot_area(x, y, width, height, stream),
             ]);
             this._onScreenshotComplete(stream, file, invocation);
@@ -2692,7 +2718,7 @@ export class ScreenshotService {
 
         try {
             await Promise.all([
-                flash ? this._flashAsync(screenshot) : null,
+                flash || screenshot._lisaForceFlash ? this._flashAsync(screenshot) : null,
                 screenshot.screenshot_window(includeFrame, includeCursor, stream),
             ]);
             this._onScreenshotComplete(stream, file, invocation);
@@ -2715,7 +2741,7 @@ export class ScreenshotService {
 
         try {
             await Promise.all([
-                flash ? this._flashAsync(screenshot) : null,
+                flash || screenshot._lisaForceFlash ? this._flashAsync(screenshot) : null,
                 screenshot.screenshot(includeCursor, stream),
             ]);
             this._onScreenshotComplete(stream, file, invocation);
