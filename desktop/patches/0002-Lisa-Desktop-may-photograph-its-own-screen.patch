diff --git a/js/misc/lisaSystemCaller.js b/js/misc/lisaSystemCaller.js
new file mode 100644
index 0000000..7ee3d5e
--- /dev/null
+++ b/js/misc/lisaSystemCaller.js
@@ -0,0 +1,178 @@
+// -*- mode: js; js-indent-level: 4; indent-tabs-mode: nil -*-
+//
+// Lisa Desktop — is the process on the other end of this D-Bus call one
+// of Lisa's own system binaries?  (lisa-os#266, ADR-0033, ADR-0048)
+//
+// This exists because GNOME's DBusSenderChecker answers a different
+// question: it asks whether the sender's unique name is the *current
+// owner of a well-known bus name*.  That is the right check for
+// gnome-settings-daemon and for xdg-desktop-portal-gnome, which are
+// started by the session and own their names for its lifetime.  It is
+// the wrong check for us, because a well-known name is claimed
+// first-come on a bus every process on the seat can reach: adding
+// "dev.lisaos.Something" to that allowlist would grant screen capture to
+// whoever asked the bus for the name first.  Authorisation that can be
+// obtained by asking nicely is not authorisation (CLAUDE.md rule 6a).
+//
+// So identity comes from the transport instead (ADR-0033).  Three facts,
+// none of them supplied by the caller:
+//
+//   1. the bus daemon reports the peer's pid and uid, taken from
+//      SO_PEERCRED on the peer's own socket.  Nothing in the message
+//      body is consulted, so there is nothing in it to forge.
+//   2. /proc/<pid>/exe is the kernel's link to the inode that process is
+//      executing.  A process cannot change it except by exec()ing
+//      something else, at which point it *is* something else.
+//   3. that inode's ownership and mode say whether anyone but root could
+//      have put the code there.
+//
+// What that adds up to, stated so nobody has to infer it:
+//
+//   * ALLOWED: a process running a regular file that lives directly in
+//     /usr/lib/lisa/bin, is owned by uid 0, is not writable by group or
+//     other, in a directory that is itself root-owned and not
+//     group/other-writable — and whose uid is the uid this shell runs
+//     as.  That directory is installed by the OS image and is read-only
+//     to every non-root process on the machine.
+//   * REFUSED: everything else on the bus.  Notably `gdbus`, `gjs`,
+//     `python`, any GJS shell surface or Lisa app, any agent's shell
+//     tool, a copy of the Lisa CLI in $HOME — and the Lisa CLI's own
+//     runtime-channel copy under /var/lib/lisa-apps, which is owned by
+//     the user and therefore replaceable by the user (measured on the
+//     reference device: -rwxr-xr-x 1 lisa lisa).  A capability that an
+//     unprivileged update channel can hand to arbitrary code is not one
+//     we are granting.
+//
+// Two limits, written down because a reader who discovers them later
+// would be right to distrust everything above:
+//
+//   * This authorises a BINARY, not an intention.  Anyone who can run
+//     /usr/lib/lisa/bin/lisa can reach whatever that binary exposes, and
+//     LD_PRELOAD into a non-setuid process is available to whoever owns
+//     it.  That is deliberate: a guardrail sits between the model and
+//     the machine, never between a person and their own machine
+//     (ADR-0029/0030).  The agent-facing decision — untrusted
+//     provenance, screen.once, the Ledger entry — belongs to the Lisa
+//     CLI's guard, which is exactly why the capture path is narrowed to
+//     one auditable binary instead of left open to every process on the
+//     bus.
+//   * Therefore never allowlist an interpreter.  /usr/bin/gjs is
+//     root-owned and unwritable too, and allowlisting it would grant
+//     this to every script on the system.  The directory checked here
+//     holds compiled Lisa binaries and is populated by the image.
+
+import Gio from 'gi://Gio';
+import GLib from 'gi://GLib';
+
+/**
+ * The one directory whose contents are Lisa's own system tooling. Not
+ * configurable, not overridable by an environment variable, not read
+ * from a file: a setting a caller can influence is a setting a caller
+ * can grant itself.
+ */
+const LISA_SYSTEM_BINDIR = '/usr/lib/lisa/bin';
+
+/**
+ * @param {string} path - the path to stat, without following symlinks
+ * @param {Gio.FileType} wantType - the file type it must have
+ * @returns {boolean} true if root owns it and no one else can write it
+ */
+function _rootOwnedAndUnwritable(path, wantType) {
+    let info;
+    try {
+        info = Gio.File.new_for_path(path).query_info(
+            'standard::type,unix::uid,unix::mode',
+            Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, null);
+    } catch {
+        return false;
+    }
+
+    if (info.get_file_type() !== wantType)
+        return false;
+    if (info.get_attribute_uint32('unix::uid') !== 0)
+        return false;
+
+    // Group- or other-writable means someone who is not root can replace
+    // what runs from here. The answer to that is no, not "in practice
+    // nobody would": this fails closed on a machine whose permissions
+    // have been loosened, which is the machine that needs it to.
+    return (info.get_attribute_uint32('unix::mode') & 0o022) === 0;
+}
+
+/**
+ * Identify the caller of @invocation as one of Lisa's system binaries.
+ *
+ * @async
+ * @param {Gio.DBusMethodInvocation} invocation - the invocation to check
+ * @returns {Promise<?{pid: number, exe: string}>} the caller, or null if
+ *   it is not Lisa system tooling. Every failure path returns null:
+ *   there is no error to report that would not also be a way to learn
+ *   whether a given pid exists.
+ */
+export async function lisaSystemCaller(invocation) {
+    let credentials;
+    try {
+        const reply = await invocation.get_connection().call(
+            'org.freedesktop.DBus',
+            '/org/freedesktop/DBus',
+            'org.freedesktop.DBus',
+            'GetConnectionCredentials',
+            new GLib.Variant('(s)', [invocation.get_sender()]),
+            new GLib.VariantType('(a{sv})'),
+            Gio.DBusCallFlags.NONE,
+            -1,
+            null);
+        [credentials] = reply.recursiveUnpack();
+    } catch {
+        return null;
+    }
+
+    const pid = credentials['ProcessID'];
+    const uid = credentials['UnixUserID'];
+    if (!Number.isInteger(pid) || !Number.isInteger(uid))
+        return null;
+
+    // The session bus is per-user, so this is normally true by
+    // construction — but "normally true" is not a check, and the case
+    // where it is false (somebody else was let onto this bus) is exactly
+    // the case that must not capture this screen.
+    let ownUid;
+    try {
+        ownUid = Gio.Credentials.new().get_unix_user();
+    } catch {
+        return null;
+    }
+    if (uid !== ownUid)
+        return null;
+
+    // The pid cannot be stale here: it belongs to a connection the bus
+    // daemon still holds open, and the kernel does not reuse the pid of
+    // a live process. A caller that exec()s between the credential read
+    // and this readlink only changes which binary we see — and if that
+    // binary is not ours, the answer is no.
+    let exe;
+    try {
+        exe = GLib.file_read_link(`/proc/${pid}/exe`);
+    } catch {
+        return null;
+    }
+
+    // readlink() on a process whose binary has been unlinked yields
+    // "<path> (deleted)". Whatever that was, it is not the file the
+    // stat below would inspect.
+    if (exe.endsWith(' (deleted)'))
+        return null;
+
+    // A direct child of the directory, compared against the kernel's own
+    // canonical path — so there is no "..", no symlink, and no second
+    // path to the same place to be clever with.
+    if (GLib.path_get_dirname(exe) !== LISA_SYSTEM_BINDIR)
+        return null;
+
+    if (!_rootOwnedAndUnwritable(LISA_SYSTEM_BINDIR, Gio.FileType.DIRECTORY))
+        return null;
+    if (!_rootOwnedAndUnwritable(exe, Gio.FileType.REGULAR))
+        return null;
+
+    return {pid, exe};
+}
